{
  "expo": {
    "name": "Tactica",
    "slug": "tactica-mobile",
    "scheme": "tactica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D1317"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lineafootball.tactica"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1317"
      },
      "package": "com.lineafootball.tactica"
    },
    "extra": {
      "apiUrl": "https://tactica-backend-hdbd.onrender.com"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
